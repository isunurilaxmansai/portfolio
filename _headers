# Read by Cloudflare Pages and Netlify. Images rarely change, so browsers can cache them for a year;
# the page, CSS and JS are revalidated on every visit so updates show up immediately.
/images/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
